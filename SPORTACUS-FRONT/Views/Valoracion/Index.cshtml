@using System.Linq
@model IEnumerable<SPORTACUS_FRONT.Models.ValoracionViewModel>

@{
    ViewData["Title"] = "Valoraciones";
    var items = Model ?? Enumerable.Empty<SPORTACUS_FRONT.Models.ValoracionViewModel>();
}

<div class="sportacus-home">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h1 class="sportacus-section-title mb-0">Valoraciones</h1>
        <a asp-action="Create">Crear nueva</a>
    </div>

    <div class="sportacus-list">
        @foreach (var item in items)
        {
            <div class="sportacus-rating-card">
                <div class="sportacus-rating-header">
                    <div class="sportacus-rating-product">@item.ProductoNombre</div>
                    <div class="sportacus-rating-stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="@(i <= item.Puntuacion ? "star-filled" : "star-empty")">★</span>
                        }
                    </div>
                </div>

                <div class="sportacus-rating-meta">
                    @item.NombreComprador (@item.EmailComprador) → @item.NombreVendedor (@item.EmailVendedor)
                    @if (item.FechaValoracion.HasValue)
                    {
                        <span> · @item.FechaValoracion.Value</span>
                    }
                </div>

                <div class="sportacus-rating-comment">
                    @item.Comentario
                </div>

                <div class="mt-2">
                    <a asp-action="Details" asp-route-id="@item.Id">Ver detalle</a>
                </div>
            </div>
        }
    </div>

    @if (!items.Any())
    {
        <p>No hay valoraciones todavía.</p>
    }
</div>
