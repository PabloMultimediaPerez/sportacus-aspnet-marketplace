@{
    ViewData["Title"] = "Panel de administración";
}

<div class="container mt-4">
    <h1 class="mb-4">Panel de administración</h1>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Gestión de usuarios</h5>
                    <p class="card-text">Ver y administrar todos los usuarios registrados.</p>
                    <a asp-controller="Admin" asp-action="Usuarios" class="btn btn-primary">Ir a usuarios</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Gestión de productos</h5>
                    <p class="card-text">Ver y administrar todos los productos publicados.</p>
                    <a asp-controller="Admin" asp-action="Productos" class="btn btn-primary">Ir a productos</a>
                </div>
            </div>
        </div>
    </div>
</div>
