@model SPORTACUS_FRONT.Models.UsuarioViewModel

@{
    ViewData["Title"] = "Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="sportacus-profile">
    <h1 class="sportacus-section-title">Perfil</h1>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="sportacus-profile-card">
                <div class="sportacus-profile-avatar"></div>
                <div class="sportacus-profile-name">@Model.Nombre</div>
                <div class="sportacus-profile-email">@Model.Email</div>
                <div class="text-muted mt-1">@Model.Telefono</div>
            </div>

            <div class="sportacus-profile-menu">
                <a asp-controller="Compra" asp-action="Index">Compras</a>
                <a asp-controller="Compra" asp-action="Index" asp-route-modo="ventas">Ventas</a>
                <a asp-controller="Favorito" asp-action="Index">Favoritos</a>
                <a asp-controller="Notificacion" asp-action="Index">Notificaciones</a>
                <a asp-action="Edit" asp-route-id="@Model.Email">Ajustes de perfil</a>
                <a asp-controller="Usuario" asp-action="Logout">Cerrar sesión</a>
            </div>
        </div>

        <div class="col-md-8">
            <div class="sportacus-profile-section">
                <h2 class="h5 mb-3">Detalles de la cuenta</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Teléfono</dt>
                    <dd class="col-sm-8">@Model.Telefono</dd>

                    <dt class="col-sm-4">Dirección</dt>
                    <dd class="col-sm-8">@Model.Direccion</dd>

                    <dt class="col-sm-4">Fecha de registro</dt>
                    <dd class="col-sm-8">@Model.FechaRegistro</dd>

                    <dt class="col-sm-4">Administrador</dt>
                    <dd class="col-sm-8">@Model.EsAdministrador</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
