@model SPORTACUS_FRONT.Models.ValoracionViewModel

@{
    ViewData["Title"] = "Valoración";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="sportacus-home">
    <h1 class="sportacus-section-title">Valoración</h1>

    <div class="sportacus-rating-card">
        <div class="sportacus-rating-header">
            <div class="sportacus-rating-product">@Model.ProductoNombre</div>
            <div class="sportacus-rating-stars">
                @for (int i = 1; i <= 5; i++)
                {
                    <span class="@(i <= Model.Puntuacion ? "star-filled" : "star-empty")">★</span>
                }
            </div>
        </div>

        <div class="sportacus-rating-meta">
            @Model.NombreComprador (@Model.EmailComprador) → @Model.NombreVendedor (@Model.EmailVendedor)
            @if (Model.FechaValoracion.HasValue)
            {
                <span> · @Model.FechaValoracion.Value</span>
            }
        </div>

        <div class="sportacus-rating-comment">
            @Model.Comentario
        </div>
    </div>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-action="Index">Volver al listado</a>
        @Html.ActionLink("Editar", "Edit", new { id = Model.Id })
    </div>
</div>
