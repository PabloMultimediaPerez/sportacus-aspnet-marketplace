<?xml version="1.0" encoding="utf-8" ?>
		<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
		                   assembly="SportacusGen.Infraestructure"
		                   namespace="SportacusGen.Infraestructure.EN.Sportacus">
		    
		    
			
				<class name="ImagenNH" table="Imagen"> 
				  	
						<id name="Id" column="id" type="integer"> 
							<generator class="hilo"/>
						</id>
			
					
					<property name="Url" type="string"> 
						<column name="url"  not-null="true"/>
					</property>
					<property name="Descripcion" type="string"> 
						<column name="descripcion"  not-null="true"/>
					</property>
					<property name="FechaSubida" type="date"> 
						<column name="fechaSubida"  not-null="true"/>
					</property>
			
			
			
			
			
			
		  			
						<many-to-one name="Producto" class="SportacusGen.Infraestructure.EN.Sportacus.ProductoNH" >	
								<column name="FK_id_idImagen_0"/> 
						</many-to-one>
											 					
					
					
					
					
					
		
		 </class>	
		  
		  <query name="ImagenNHReadAllHQL">from ImagenNH</query>
		</hibernate-mapping>
	