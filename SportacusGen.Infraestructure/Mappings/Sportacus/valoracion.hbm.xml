<?xml version="1.0" encoding="utf-8" ?>
		<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
		                   assembly="SportacusGen.Infraestructure"
		                   namespace="SportacusGen.Infraestructure.EN.Sportacus">
		    
		    
			
				<class name="ValoracionNH" table="Valoracion"> 
				  	
						<id name="Id" column="id" type="integer"> 
							<generator class="hilo"/>
						</id>
			
					
					<property name="Puntuacion" type="integer"> 
						<column name="puntuacion"  not-null="true"/>
					</property>
					<property name="Comentario" type="string"> 
						<column name="comentario"  not-null="true"/>
					</property>
					<property name="FechaValoracion" type="date"> 
						<column name="fechaValoracion"  not-null="true"/>
					</property>
			
			
			
			
			
			
		  			
						<many-to-one name="Vendedor" class="SportacusGen.Infraestructure.EN.Sportacus.UsuarioNH" >	
								<column name="FK_id_idValoracion"/> 
						</many-to-one>
											 					
			
		  			
						<many-to-one name="Comprador" class="SportacusGen.Infraestructure.EN.Sportacus.UsuarioNH" >	
								<column name="FK_id_idComprador"/> 
						</many-to-one>
											 					
			
		  			
						<many-to-one name="Producto" class="SportacusGen.Infraestructure.EN.Sportacus.ProductoNH" >	
								<column name="FK_id_idValoracion_2"/> 
						</many-to-one>
											 					
					
					
					
					
					
					
					
		
		 </class>	
		  
		  <query name="ValoracionNHReadAllHQL">from ValoracionNH</query>
		</hibernate-mapping>
	