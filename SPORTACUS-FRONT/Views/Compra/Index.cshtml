@using System.Linq
@model IEnumerable<SPORTACUS_FRONT.Models.CompraViewModel>

@{
    var items = Model ?? Enumerable.Empty<SPORTACUS_FRONT.Models.CompraViewModel>();
    var modo = (string?)ViewContext.HttpContext.Request.Query["modo"];
    bool esVentas = string.Equals(modo, "ventas", StringComparison.OrdinalIgnoreCase);

    ViewData["Title"] = esVentas ? "Ventas" : "Compras";
    var titulo = esVentas ? "Ventas" : "Compras";
    var textoTotal = esVentas ? "Total de productos vendidos" : "Total de productos comprados";
    var textoVacio = esVentas ? "No has realizado ninguna venta todavía." : "No has realizado ninguna compra todavía.";
}

<div class="sportacus-home">
    <h1 class="sportacus-section-title">@titulo</h1>
    <p>@textoTotal: @items.Count()</p>

    @if (TempData["CompraOk"] != null)
    {
        <div class="alert alert-success mt-2">@TempData["CompraOk"]</div>
    }
    @if (TempData["CompraError"] != null)
    {
        <div class="alert alert-danger mt-2">@TempData["CompraError"]</div>
    }

    <div class="sportacus-card-grid">
        @foreach (var item in items)
        {
            <a asp-controller="Producto" asp-action="Details" asp-route-id="@item.ProductoId" class="sportacus-product-card-link">
                <div class="sportacus-product-card">
                    @if (!string.IsNullOrEmpty(item.ProductoImagenUrl))
                    {
                        <img src="@item.ProductoImagenUrl" alt="@item.ProductoTitulo" class="sportacus-product-image-placeholder img-fluid" style="object-fit: cover;" />
                    }
                    else
                    {
                        <div class="sportacus-product-image-placeholder"></div>
                    }
                    <div class="sportacus-product-title">@item.ProductoTitulo</div>
                    <div class="sportacus-product-price">@item.PrecioFinal.ToString("0.##")$</div>
                </div>
            </a>
        }
    </div>

    @if (!items.Any())
    {
        <p>@textoVacio</p>
    }
</div>
