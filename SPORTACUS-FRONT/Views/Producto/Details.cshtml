@model SPORTACUS_FRONT.Models.ProductoViewModel

@using System.Linq
@using Microsoft.AspNetCore.Http
@using SportacusGen.ApplicationCore.CEN.Sportacus
@using SportacusGen.Infraestructure.Repository.Sportacus

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="sportacus-product-detail">
    @if (TempData["FavoritoOk"] != null)
    {
        <div class="alert alert-success mb-3">
            @TempData["FavoritoOk"]
        </div>
    }

    <div class="row g-4">
        <div class="col-md-6">
            <div class="sportacus-product-detail-image">
                @if (Model.ImagenesUrls != null && Model.ImagenesUrls.Any())
                {
                    var carouselId = "productCarousel_" + Model.Id;
                    <div id="@carouselId" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @for (int i = 0; i < Model.ImagenesUrls.Count; i++)
                            {
                                var url = Model.ImagenesUrls[i];
                                <div class="carousel-item @(i == 0 ? "active" : string.Empty)">
                                    <img src="@url" alt="@Model.Titulo" class="d-block w-100" style="object-fit: cover; height: 260px; border-radius: 0.75rem;" />
                                </div>
                            }
                        </div>

                        @if (Model.ImagenesUrls.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Anterior</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Siguiente</span>
                            </button>
                        }
                    </div>
                }

                <form asp-controller="MisFavoritos" asp-action="@(Model.EsFavorito ? "Remove" : "Add")" method="post" class="sportacus-fav-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productoId" value="@Model.Id" />
                    <button type="submit" class="sportacus-fav-button @(Model.EsFavorito ? "sportacus-fav-button-filled" : "")">
                        @(Model.EsFavorito ? "♥" : "♡")
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-6 d-flex flex-column justify-content-between">
            <div>
                <h1 class="sportacus-product-detail-title">@Model.Titulo</h1>
                <div class="sportacus-product-detail-price">@Model.Precio.ToString("0.##")$</div>
                <div class="sportacus-product-detail-meta mt-2">
                    <div><strong>Estado:</strong> @Model.Estado</div>
                    <div><strong>Categoría:</strong> @Model.Categoria</div>
                </div>
            </div>

            <div class="mt-3">
                <div class="sportacus-product-detail-description-label">Descripción</div>
                <div class="sportacus-product-detail-description-box">
                    @Model.Descripcion
                </div>
            </div>

            <div class="mt-3 d-flex align-items-center justify-content-between">
                <div>
                    <div><strong>Vendedor:</strong> @Model.UsuarioNombre</div>
                    <div class="text-muted">@Model.UsuarioEmail</div>
                </div>

                <div class="d-flex gap-2">
                    <form asp-controller="Compra" asp-action="Comprar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productoId" value="@Model.Id" />
                        <input type="hidden" name="vendedorEmail" value="@Model.UsuarioEmail" />
                        <input type="hidden" name="productoTitulo" value="@Model.Titulo" />
                        <input type="hidden" name="precio" value="@Model.Precio" />
                        <button type="submit" class="btn btn-sportacus-primary">Comprar</button>
                    </form>
                    <a asp-controller="Chat" asp-action="Conversation" asp-route-otroEmail="@Model.UsuarioEmail" class="btn btn-outline-light border">
                        💬 Chat
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index">Volver al listado</a>
    </div>
</div>
