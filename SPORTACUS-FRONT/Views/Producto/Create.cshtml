@using SportacusGen.ApplicationCore.Enumerated.Sportacus
@model SPORTACUS_FRONT.Models.ProductoViewModel

@{
    ViewData["Title"] = "Publicar anuncio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="sportacus-product-create">
    <h1 class="sportacus-section-title">Publicar anuncio</h1>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="sportacus-product-detail-image d-flex align-items-center justify-content-center">
                <span>Imágenes</span>
            </div>
        </div>

        <div class="col-md-6">
            <form asp-controller="Imagen" asp-action="CreateProductoConImagen" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label">Nombre</label>
                    <input asp-for="Titulo" class="form-control" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Precio" class="form-label">Precio</label>
                    <input asp-for="Precio" class="form-control" />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Estado" class="form-label"></label>
                    <select asp-for="Estado" class="form-control"
                            asp-items="Html.GetEnumSelectList<EstadoProductoEnum>()">
                        <option value="">Selecciona el estado del producto</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Categoria" class="form-label"></label>
                    <select asp-for="Categoria" class="form-control"
                            asp-items="Html.GetEnumSelectList<CategoriaEnum>()">
                        <option value="">Selecciona la categoría del producto</option>
                    </select>
                    <span asp-validation-for="Categoria" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Imágenes del producto</label>
                    <input type="file" name="imagenesArchivos" class="form-control" accept="image/*" multiple />
                </div>

                <div class="mb-3">
                    <label asp-for="FechaPublicacion" class="form-label"></label>
                    <input asp-for="FechaPublicacion" class="form-control" />
                    <span asp-validation-for="FechaPublicacion" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input class="form-check-input" asp-for="Disponible" />
                    <label class="form-check-label" asp-for="Disponible"></label>
                </div>

                <div class="mb-3">
                    <label asp-for="UsuarioEmail" class="form-label"></label>
                    <input asp-for="UsuarioEmail" class="form-control" />
                    <span asp-validation-for="UsuarioEmail" class="text-danger"></span>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-sportacus-primary w-100">Publicar</button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index">Volver al listado</a>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
