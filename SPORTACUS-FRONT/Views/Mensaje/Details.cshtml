@model SPORTACUS_FRONT.Models.MensajeViewModel

@{
    ViewData["Title"] = "Chat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="sportacus-chat">
    <h1 class="sportacus-section-title">@Model.EmisorNombre</h1>

    <div class="sportacus-chat-messages">
        <div class="sportacus-chat-bubble">
            @Model.Contenido
        </div>

        @if (!string.IsNullOrEmpty(Model.UrlMultimedia))
        {
            <div class="sportacus-chat-bubble sportacus-chat-bubble-media">
                @Model.UrlMultimedia
            </div>
        }
    </div>

    <div class="sportacus-chat-input-wrapper">
        <span class="sportacus-chat-icon">&#128247;</span>
        <input type="text" class="form-control sportacus-chat-input"
               placeholder="Escribe tu mensaje aqui..." disabled />
        <span class="sportacus-chat-icon">&#127908;</span>
    </div>

    <div class="mt-3 d-flex justify-content-between">
        <a asp-action="Index">Volver a mensajes</a>
        <a asp-action="Create" class="btn btn-outline-light border">Nuevo mensaje</a>
    </div>
</div>
