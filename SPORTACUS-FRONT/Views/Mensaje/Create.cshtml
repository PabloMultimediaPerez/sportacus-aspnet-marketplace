@using SportacusGen.ApplicationCore.Enumerated.Sportacus
@model SPORTACUS_FRONT.Models.MensajeViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Crear</h1>

<h4>Mensaje</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Contenido" class="control-label"></label>
                <input asp-for="Contenido" class="form-control" />
                <span asp-validation-for="Contenido" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaEnvio" class="control-label"></label>
                <input asp-for="FechaEnvio" class="form-control" />
                <span asp-validation-for="FechaEnvio" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Leido" /> @Html.DisplayNameFor(model => model.Leido)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="TipoMensaje" class="control-label"></label>
                <select asp-for="TipoMensaje" class="form-control"
                        asp-items="Html.GetEnumSelectList<TipoMensajeEnum>()">
                    <option value="">Selecciona el tipo de mensaje</option>
                </select>
                <span asp-validation-for="TipoMensaje" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UrlMultimedia" class="control-label"></label>
                <input asp-for="UrlMultimedia" class="form-control" />
                <span asp-validation-for="UrlMultimedia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmisorEmail" class="control-label"></label>
                <input asp-for="EmisorEmail" class="form-control" />
                <span asp-validation-for="EmisorEmail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReceptorEmail" class="control-label"></label>
                <input asp-for="ReceptorEmail" class="form-control" />
                <span asp-validation-for="ReceptorEmail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
